# Salin menjadi .env (jangan di-commit)
MONGO_URL=mongodb://localhost:27017
DB_NAME=gasgalon_erp
# Wajib diisi di produksi: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Set false di produksi setelah akun asli dibuat (POST /api/users)
SEED_DEMO_USERS=true
